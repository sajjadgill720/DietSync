# ==============================================================================
# DietSync Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection Link (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dietsync

# ------------------------------------------------------------------------------
# 2. Message Broker Connection Link (RabbitMQ)
# ------------------------------------------------------------------------------
# Format: amqp://[user]:[password]@[host]:[port]/
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ------------------------------------------------------------------------------
# 3. LLM API Key (OpenAI) - RECOMMENDED
# ------------------------------------------------------------------------------
# Used by LangGraph nodes (gpt-4o-mini) for dynamic claim extraction and independent
# label groundedness auditing.
# Note: Deterministic allergy cross-reactivity uses NIH RxClass with 0 LLM calls.
# Seeded demo pairs also work with built-in grounded parser fallbacks if key is absent.
OPENAI_API_KEY=your-openai-api-key-here

# ------------------------------------------------------------------------------
# 4. Observability & Tracing (LangSmith) - OPTIONAL
# ------------------------------------------------------------------------------
# Enable only if you want visual trace execution graphs in LangSmith.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=dietsync

